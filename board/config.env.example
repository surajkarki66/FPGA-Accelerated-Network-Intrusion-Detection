# Vivado 2024.2 project (create with: make board-bd)
VIVADO_PROJ=/path/to/vivado_fnn_zcu104
VIVADO_XPR=$VIVADO_PROJ/vivado_fnn_zcu104.xpr
BOARD_PART=xilinx.com:zcu104:part0:1.1
FPGA_PART=xczu7ev-ffvc1156-2-e

# Packaged fpga_top IP (make board-package)
IP_REPO=/path/to/FPGA-Accelerated-Network-Intrusion-Detection/board/out/ip_repo

# Output bitstream (make board-bitstream)
BITSTREAM=$VIVADO_PROJ/fnn_bd_wrapper.bit

# Prebuilt ZCU104 firmware (clone Xilinx/soc-prebuilt-firmware @ xilinx_v2024.2)
FW_DIR=/path/to/soc-prebuilt-firmware/zcu104-zynqmp

# PetaLinux prebuilt WIC
WIC_IMG=/path/to/petalinux-zcu104.wic

# SD card block device on the build PC
SD_DEV=/dev/mmcblk0

# Board over SSH
BOARD_HOST=192.168.1.100
BOARD_USER=root
BOARD_PASS=fnn

# FNN AXI base from Vivado Address Editor (40-bit HPM1 aperture)
FNN_BASE_ADDR=0x400000000
PL_CLK_MHZ=100
